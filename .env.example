# Horizon endpoint (testnet by default for all Phase 1 work/demos)
HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar network passphrase (must match HORIZON_URL's network)
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# Path to the JSON file used as the Phase 1 deal store
DEAL_STORE_PATH=./data/deals.json

# Seconds from "now" until a demo deal's closing deadline
# (kept short so both demo scripts complete without a long wait)
DEMO_DEADLINE_SECONDS=30

{
  "name": "earnest-escrow",
  "version": "0.1.0",
  "private": true,
  "description": "Transparent real estate earnest money escrow built on Stellar Claimable Balances",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
